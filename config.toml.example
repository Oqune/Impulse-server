# Impulse server configuration.
# Copy to `config.toml` next to the executable, or pass `--config <path>`.
# CLI flags always override values here.

[server]
# Socket address the WebTransport (QUIC) endpoint binds to.
# WebTransport standard port (4433). Client defaults to this port as well.
address = "0.0.0.0:4433"

# Directory where the self-signed certificate + key are persisted (relative to exe).
cert_dir = "cert_data"

# Extra Subject Alternative Names for the generated certificate (DNS or IP).
san = []

# REQUIRED. SHA-256 (hex) of the password. The client hashes the password
# client-side and sends the hex string; the server compares it directly.
# Generate with:
#   printf 'yourpassword' | sha256sum
# or using the `impulse-server --hash-password <pw>` command.
password_hash = "ef92b778bafe771e89245b89ecbc08a44a4e166c06659911881f383d4473e94f"
