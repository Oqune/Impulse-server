# Impulse server configuration.
# Copy to `config.toml` next to the executable, into the working directory,
# or pass the path explicitly with `--config <path>`.
# CLI flags always override values here.

[server]
# Primary socket address the WebTransport (QUIC) endpoint binds to.
# Default: "[::]:4433" (IPv4/IPv6 Dual-Stack). Falls back to 0.0.0.0:4433 if IPv6 is disabled.
# `--host` / `--bind` / `--port` flags override this value.
address = "[::]:4433"

# Directory where the self-signed certificate + key are persisted (relative to exe).
cert_dir = "cert_data"

# Extra Subject Alternative Names for the generated certificate (DNS or IP).
san = []

# REQUIRED. Argon2id encoded password hash. The client sends the password
# Argon2id-hashed; the server compares it directly against this value.
# Generate with:
#   impulse-server --init            # interactive wizard (writes config.toml)
#   impulse-server --hash-password <password>
# Empty (or unset) = the server refuses to start until configured.
password_hash = ""
